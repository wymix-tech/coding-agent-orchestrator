# CAO runtime state (project-local, generated by the `cao` CLI). Keep config.json trackable.
.orchestrator/*
!.orchestrator/config.json

# Isolated implementation worktrees
.worktrees/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging output
build/
dist/
*.egg-info/

# Operating systems and editors
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
