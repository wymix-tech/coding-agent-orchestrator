{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project initialization input v1",
  "type": "object",
  "required": ["schema_version", "identity", "evidence", "rule", "files", "checks", "required_capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "rule": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"const": 1}}},
    "basis": {"type": "string"},
    "identity": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "evidence": {"type": "string", "pattern": "^user-[a-f0-9]{64}$"},
    "source": {"enum": ["user-specified", "user-delegated"]},
    "framework_support": {"type": "string"},
    "delivery_support": {"type": "string"},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "content", "purpose"], "properties": {"path": {"type": "string", "minLength": 1}, "content": {"type": "string"}, "purpose": {"enum": ["manifest", "entry", "test", "resource", "verification"]}}}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "command", "capability"], "properties": {"name": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}, "capability": {"enum": ["build", "syntax", "type", "load", "startup", "test", "security"]}, "cwd": {"type": "string"}, "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}}}},
    "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["build", "syntax", "type", "load", "startup", "test", "security"]}},
    "outputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
