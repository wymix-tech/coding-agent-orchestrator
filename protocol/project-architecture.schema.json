{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAO architecture Skill frontmatter",
  "type": "object",
  "required": ["name", "description", "metadata"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "description": {"type": "string", "minLength": 1},
    "metadata": {
      "type": "object",
      "required": ["cao"],
      "properties": {
        "cao": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "rule_id", "rule_version", "stack", "style", "scope", "source_roots", "test_roots"],
          "properties": {
            "schema_version": {"const": 1},
            "rule_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
            "rule_version": {"type": "integer", "minimum": 1},
            "stack": {"type": "object", "additionalProperties": {"type": "string"}},
            "style": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1},
            "source_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "test_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "from", "forbidden"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "kind": {"enum": ["java-package-dependency", "java-source-layout"]},
                  "from": {"type": "string", "minLength": 1},
                  "forbidden": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
