{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAO Project Context v1",
  "type": "object",
  "required": ["schema_version", "revision", "content_sha256", "scopes", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "string", "pattern": "^ctx-[a-f0-9]{64}$"},
    "previous_revision": {"type": "string", "pattern": "^ctx-[a-f0-9]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scopes": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9_.-]+$"},
      "additionalProperties": {
        "type": "object", "required": ["paths", "technology"],
        "properties": {
          "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "versions": {"type": "object", "additionalProperties": {"type": "string"}},
          "technology": {
            "type": "object",
            "propertyNames": {"enum": ["language", "framework", "build_tool", "test_framework", "storage", "delivery"]},
            "additionalProperties": {
              "type": "object", "required": ["value", "status"],
              "properties": {
                "value": {"type": ["string", "null"]},
                "status": {"enum": ["accepted", "pending", "conflict", "not_applicable"]}
              }
            }
          }
        }
      }
    },
    "evidence": {"type": "array", "items": {"type": "object"}},
    "active_changes": {"type": "array", "items": {"type": "string", "pattern": "^change-[a-f0-9]{64}$"}}
  }
}
