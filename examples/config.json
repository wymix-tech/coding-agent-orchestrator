{
  "version": 1,
  "language": {
    "user": "zh-CN"
  },
  "verification": {
    "timeout_seconds": 300,
    "scripts": [
      {
        "name": "unit-tests",
        "command": "./scripts/verify-unit-tests.sh",
        "required": true,
        "gates": ["tests"]
      },
      {
        "name": "coverage",
        "command": "./scripts/verify-coverage.sh",
        "required": true,
        "gates": []
      }
    ]
  },
  "rules": {
    "files": [
      "AGENTS.md",
      "CLAUDE.md",
      ".orchestrator/rules/*.md"
    ]
  },
  "sdd": {
    "provider": "auto",
    "requirement_globs": [
      "requirements/**/*.md",
      "specs/**/*.md",
      "openspec/**/*.md",
      "_bmad/**/*.md"
    ],
    "exclude_globs": [],
    "command": {
      "inspect": "",
      "transition": ""
    }
  }
}
