{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CAO_REPO=\"${CLAUDE_PROJECT_DIR}\" sh /PATH/TO/coding-agent-orchestrator/hooks/host-event.sh --host claude-code"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CAO_REPO=\"${CLAUDE_PROJECT_DIR}\" sh /PATH/TO/coding-agent-orchestrator/hooks/host-event.sh --host claude-code"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "CAO_REPO=\"${CLAUDE_PROJECT_DIR}\" sh /PATH/TO/coding-agent-orchestrator/hooks/host-event.sh --host claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "CAO_REPO=\"${CLAUDE_PROJECT_DIR}\" sh /PATH/TO/coding-agent-orchestrator/hooks/host-event.sh --host claude-code"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CAO_REPO=\"${CLAUDE_PROJECT_DIR}\" sh /PATH/TO/coding-agent-orchestrator/hooks/host-event.sh --host claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CAO_REPO=\"${CLAUDE_PROJECT_DIR}\" sh /PATH/TO/coding-agent-orchestrator/hooks/host-event.sh --host claude-code"
          }
        ]
      }
    ]
  }
}
