    "PostToolUse": [{"matcher": "Write|Edit|Bash|mcp__.*", "hooks": [{"type": "command", "command": "python3 \"__KERNEL__\" host --host claude-code", "timeout": 15}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "python3 \"__KERNEL__\" host --host claude-code", "timeout": 10}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "python3 \"__KERNEL__\" host --host claude-code", "timeout": 15}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 \"__KERNEL__\" host --host claude-code", "timeout": 15}]}]
