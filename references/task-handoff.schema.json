{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/orchestrator/task-handoff.schema.json",
  "title": "V6.4 Task Handoff",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "generated_at",
    "handoff_id",
    "from_role",
    "to_role",
    "work_item",
    "summary",
    "valid_for"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "task_handoff"
    },
    "generated_at": {
      "type": "string"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 8
    },
    "from_role": {
      "type": "string"
    },
    "to_role": {
      "type": "string"
    },
    "work_item": {
      "type": "object"
    },
    "completed_task": {
      "type": [
        "object",
        "null"
      ]
    },
    "summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending": {
      "type": "object"
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valid_for": {
      "type": "object",
      "required": [
        "work_item_id"
      ],
      "properties": {
        "work_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution_snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysis_snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "state_revision_at_handoff": {
          "type": [
            "integer",
            "null"
          ]
        },
        "authority_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
