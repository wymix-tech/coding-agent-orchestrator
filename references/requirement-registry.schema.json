{
  "$id": "https://example.local/orchestrator/requirement-registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
  "identity_version": {
    "const": 2
  },
  "migrated_at": {
    "type": "string"
  },
  "migration_warning": {
    "type": "string"
  },
    "requirements": {
      "additionalProperties": {
        "properties": {
          "native_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": "string"
          },
          "revisions": {
            "additionalProperties": {
              "properties": {
                "completed_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "active",
                    "completed",
                    "archived"
                  ]
                },
                "work_item_id": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "work_item_id"
              ],
              "type": "object"
            },
            "type": "object"
          },
          "identity_version": {
            "type": "integer"
          },
          "legacy": {
            "type": "boolean"
          },
          "legacy_reason": {
            "type": "string"
          },
          "members": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "migration_command": {
            "type": "string"
          },
          "native_state_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "explicit_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "work_items": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "provider",
          "revisions",
          "work_items"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "schema_version": {
      "const": 1
    }
